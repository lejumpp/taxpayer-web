# Committed baseline — loaded in every mode, lowest precedence.
# Safe, non-secret defaults only (all VITE_* vars ship in the client bundle).
# Personal overrides go in .env.local (gitignored).
# Mode-specific values live in .env.development / .env.production.

VITE_API_URL=http://localhost:5000

VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox

# Private beta: require an invite code to register. Set to true in Cloudflare Pages
# production env vars during beta; false opens registration to everyone.
VITE_BETA_INVITE_ENABLED=true
