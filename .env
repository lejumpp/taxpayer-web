# Committed baseline — loaded in every mode, lowest precedence.
# Safe, non-secret defaults only (all VITE_* vars ship in the client bundle).
# Personal overrides go in .env.local (gitignored).
# Mode-specific values live in .env.development / .env.production.

VITE_API_URL=http://localhost:5000

VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox
