# Copy to .env.local for personal overrides (points at your local API, etc.).
# .env / .env.development / .env.production are committed; .env.local is not.
VITE_API_URL=http://localhost:5000

VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox

# Private beta: require an invite code to register. Keep false for local dev.
VITE_BETA_INVITE_ENABLED=false
